{
  "name": "hotel-offer-orchestrator",
  "version": "1.0.0",
  "private": true,
  "description": "Aggregates hotel offers from two suppliers and keeps the cheapest one per hotel",
  "main": "dist/server.js",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "start": "node dist/server.js",
    "start:worker": "node dist/worker.js",
    "dev": "tsx watch src/server.ts",
    "dev:worker": "tsx watch src/worker.ts",
    "test": "vitest run"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@temporalio/activity": "^1.26.0",
    "@temporalio/client": "^1.26.0",
    "@temporalio/common": "^1.26.0",
    "@temporalio/worker": "^1.26.0",
    "@temporalio/workflow": "^1.26.0",
    "express": "^5.3.0",
    "ioredis": "^6.0.0",
    "pino": "^10.4.0"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/node": "^26.6.6",
    "tsx": "^4.23.15",
    "typescript": "~5.9",
    "vitest": "^5.1.1"
  }
}

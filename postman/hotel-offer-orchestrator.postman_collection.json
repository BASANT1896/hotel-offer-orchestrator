{
  "info": {
    "name": "Hotel Offer Orchestrator",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:3000"
    }
  ],
  "item": [
    {
      "name": "Hotels",
      "item": [
        {
          "name": "Valid city with overlaps (delhi)",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/hotels?city=delhi",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "hotels"
              ],
              "query": [
                {
                  "key": "city",
                  "value": "delhi"
                }
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status is 200', () => pm.response.to.have.status(200));",
                  "const hotels = pm.response.json();",
                  "pm.test('names are unique', () => {",
                  "  const names = hotels.map(h => h.name);",
                  "  pm.expect(new Set(names).size).to.equal(names.length);",
                  "});",
                  "pm.test('Holtin comes from the cheaper supplier', () => {",
                  "  const holtin = hotels.find(h => h.name === 'Holtin');",
                  "  pm.expect(holtin.supplier).to.equal('Supplier B');",
                  "  pm.expect(holtin.price).to.equal(5340);",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "Price filter (4000 - 6000)",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/hotels?city=delhi&minPrice=4000&maxPrice=6000",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "hotels"
              ],
              "query": [
                {
                  "key": "city",
                  "value": "delhi"
                },
                {
                  "key": "minPrice",
                  "value": "4000"
                },
                {
                  "key": "maxPrice",
                  "value": "6000"
                }
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status is 200', () => pm.response.to.have.status(200));",
                  "pm.test('every price is inside the range', () => {",
                  "  const hotels = pm.response.json();",
                  "  pm.expect(hotels).to.not.be.empty;",
                  "  hotels.forEach(h => pm.expect(h.price).to.be.within(4000, 6000));",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "City with no results",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/hotels?city=atlantis",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "hotels"
              ],
              "query": [
                {
                  "key": "city",
                  "value": "atlantis"
                }
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status is 200', () => pm.response.to.have.status(200));",
                  "pm.test('body is an empty array', () => pm.expect(pm.response.json()).to.eql([]));"
                ]
              }
            }
          ]
        },
        {
          "name": "Missing city",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/hotels",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "hotels"
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status is 400', () => pm.response.to.have.status(400));"
                ]
              }
            }
          ]
        },
        {
          "name": "minPrice greater than maxPrice",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/hotels?city=delhi&minPrice=9000&maxPrice=1000",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "hotels"
              ],
              "query": [
                {
                  "key": "city",
                  "value": "delhi"
                },
                {
                  "key": "minPrice",
                  "value": "9000"
                },
                {
                  "key": "maxPrice",
                  "value": "1000"
                }
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status is 400', () => pm.response.to.have.status(400));"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "Supplier down (optional)",
      "item": [
        {
          "name": "1. Take Supplier B down",
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/mock/suppliers/supplierB",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "mock",
                "suppliers",
                "supplierB"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"down\": true\n}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Supplier B is down', () => pm.expect(pm.response.json().down).to.be.true);"
                ]
              }
            }
          ]
        },
        {
          "name": "2. Delhi hotels with Supplier B down",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/hotels?city=delhi",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "hotels"
              ],
              "query": [
                {
                  "key": "city",
                  "value": "delhi"
                }
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status is 200', () => pm.response.to.have.status(200));",
                  "pm.test('only Supplier A offers are returned', () => {",
                  "  const hotels = pm.response.json();",
                  "  pm.expect(hotels).to.not.be.empty;",
                  "  hotels.forEach(h => pm.expect(h.supplier).to.equal('Supplier A'));",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "3. Health shows degraded",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/health",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "health"
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status is degraded', () => {",
                  "  const body = pm.response.json();",
                  "  pm.expect(body.status).to.equal('degraded');",
                  "  pm.expect(body.suppliers.supplierB).to.equal('down');",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "4. Bring Supplier B back",
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/mock/suppliers/supplierB",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "mock",
                "suppliers",
                "supplierB"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"down\": false\n}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Supplier B is up', () => pm.expect(pm.response.json().down).to.be.false);"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "Health",
      "item": [
        {
          "name": "Health check",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/health",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "health"
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status is 200', () => pm.response.to.have.status(200));",
                  "pm.test('reports both suppliers', () => {",
                  "  const body = pm.response.json();",
                  "  pm.expect(body.suppliers).to.have.keys('supplierA', 'supplierB');",
                  "});"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "Mock suppliers",
      "item": [
        {
          "name": "Supplier A hotels",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/supplierA/hotels?city=delhi",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "supplierA",
                "hotels"
              ],
              "query": [
                {
                  "key": "city",
                  "value": "delhi"
                }
              ]
            }
          }
        },
        {
          "name": "Supplier B hotels",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/supplierB/hotels?city=delhi",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "supplierB",
                "hotels"
              ],
              "query": [
                {
                  "key": "city",
                  "value": "delhi"
                }
              ]
            }
          }
        }
      ]
    }
  ]
}